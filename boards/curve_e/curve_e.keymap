#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/pointing.h>

/ {
	behaviors {
		inc_dec_msc: sensor_rotate_scroll {
			compatible = "zmk,behavior-sensor-rotate-var";
			#sensor-binding-cells = <2>;
			/* Keep scroll held beyond the 16 ms mouse input tick. */
			tap-ms = <20>;
			bindings = <&msc>, <&msc>;
		};

		td_esc: tap_dance_esc_grave {
			compatible = "zmk,behavior-tap-dance";
			#binding-cells = <0>;
			tapping-term-ms = <200>;
			bindings = <&kp ESC>, <&kp GRAVE>;
		};

		td_bspc: tap_dance_bspc_del {
			compatible = "zmk,behavior-tap-dance";
			#binding-cells = <0>;
			tapping-term-ms = <200>;
			bindings = <&kp BSPC>, <&kp DEL>;
		};
	};

	combos {
		compatible = "zmk,combos";
		combo_esc {
			timeout-ms = <50>;
			layers = <0>;
			key-positions = <1 2>; /* Q + W */
			bindings = <&kp ESC>;
		};
		combo_tab {
			timeout-ms = <50>;
			layers = <0>;
			key-positions = <14 15>; /* A + S */
			bindings = <&kp TAB>;
		};
		combo_bspc {
			timeout-ms = <50>;
			layers = <0>;
			key-positions = <9 10>; /* O + P */
			bindings = <&kp BSPC>;
		};
		combo_enter {
			timeout-ms = <50>;
			layers = <0>;
			key-positions = <21 22>; /* K + L */
			bindings = <&kp ENTER>;
		};
		combo_caps {
			timeout-ms = <50>;
			layers = <0>;
			key-positions = <29 30>; /* V + B */
			bindings = <&caps_word>;
		};
		combo_out_tog {
			timeout-ms = <50>;
			layers = <0>;
			key-positions = <26 27>; /* Z + X: Toggle USB / Bluetooth */
			bindings = <&out OUT_TOG>;
		};
	};

	conditional_layers {
		compatible = "zmk,conditional-layers";
		tri_layer {
			if-layers = <1 2>;
			then-layer = <3>;
		};
	};

	keymap {
		compatible = "zmk,keymap";

		/* Layer 0: Base Typing */
		default_layer {
			bindings = <
				&td_esc		&kp Q    &kp W    &kp E    &kp R     &kp T       &kp Y     &kp U  &kp I  &kp O  	  &kp P     &kp MINUS   &kp C_PP
			    &kp TAB     &kp A    &kp S    &kp D    &kp F     &kp G       &kp H     &kp J  &kp K  &kp L     &kp SEMI   	       &kp ENTER
			    &kp LSHIFT  &kp Z    &kp X 	  &kp C    &kp V     &kp B       &kp N     &kp M  &kp COMMA &kp PERIOD &kp SLASH &kp EQUAL &kp SQT
			    &kp LCTRL   	&kp LGUI &mo 1    &kp SPACE    &kp SPACE   &td_bspc  &kp LBKT  &kp RBKT         &mo 2
			>;
			sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP>;
		};

		/* Layer 1: Numbers & Navigation */
		num_layer {
			bindings = <
				&kp GRAVE	&kp N1   &kp N2   &kp N3   &kp N4    &kp N5      &kp N6   &kp N7    &kp N8    &kp N9    &kp N0     &kp MINUS &kp EQUAL
			    &kp TAB     &trans   &trans   &trans   &trans    &trans      &trans   &kp LEFT  &kp DOWN  &kp UP    &kp RIGHT  	       &trans
			    &kp LSHIFT  &trans   &trans   &trans   &trans    &trans      &trans   &kp HOME  &kp PG_DN &kp PG_UP &kp END    &trans	   &trans
			    &kp LCTRL   		          &trans   &trans    &trans      &trans   &trans    &trans    &trans    &trans
			>;
			sensor-bindings = <&inc_dec_kp PG_DN PG_UP>;
		};

		/* Layer 2: Symbols & Mouse / Pointer Emulation */
		mark_layer {
			bindings = <
				&kp TILDE	&kp EXCL &kp AT   &kp HASH  &kp DLLR  &kp PRCNT   &kp CARET &kp AMPS  &kp KP_MULTIPLY &kp LPAR  &kp RPAR  &kp UNDER &kp PLUS
			    &kp TAB     &trans   &trans   &trans    &trans    &trans      &trans    &mmv MOVE_LEFT &mmv MOVE_DOWN &mmv MOVE_UP &mmv MOVE_RIGHT &trans
			    &kp LSHIFT  &trans   &trans   &trans    &trans    &trans      &trans    &mkp LCLK &mkp MCLK       &mkp RCLK &trans    &trans	  &trans
			    &kp LCTRL   		          &trans    &trans    &trans      &trans    &kp DEL   &trans          &trans    &trans
			>;
			sensor-bindings = <&inc_dec_msc MOVE_Y(-100) MOVE_Y(100)>;
		};

		/* Layer 3: System & Bluetooth Management (Triggered by Layer 1 + Layer 2) */
		adjust_layer {
			bindings = <
				&bt BT_CLR 	  &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4 &out OUT_TOG &out OUT_USB &out OUT_BLE &trans &trans &trans &trans
				&trans        &trans       &trans       &trans       &trans       &trans       &trans       &trans       &trans       &trans &trans        &trans
				&trans        &trans       &trans       &trans       &trans       &trans       &caps_word   &trans       &trans       &trans &trans &trans &trans
			    &trans 		               &trans       &trans       &trans       &trans       &trans       &sys_reset   &bootloader  &trans
			>;
			sensor-bindings = <&inc_dec_kp C_BRI_DN C_BRI_UP>;
		};
	};
};
