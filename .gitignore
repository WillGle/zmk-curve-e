# ZMK build artifacts
build/
.west/
/zephyr/*
!/zephyr/module.yml
modules/
*.uf2
*.bin
*.hex
*.log

# Keep released firmware and its build evidence in the repository.
!/firmware/**/*.uf2
!/firmware/**/*.log

# Raw device dumps are local recovery evidence, not release artifacts.
/firmware/recovery-*/

# Backups
backup/

# Experimental pair secrets and firmware containing the local pair key.
/firmware/experimental/private/

# Python cache
__pycache__/
*.py[cod]
*$py.class
